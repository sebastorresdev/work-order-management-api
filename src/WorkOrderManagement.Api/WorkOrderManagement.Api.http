###############################################################################
# 1. AUTENTICACIÓN (Auth)
###############################################################################

### Login de Usuario (Obtener Token)
# @name login
POST {{baseUrl}}/api/v1/auth/login
Content-Type: application/json

{
  "username": "admin",
  "password": "Password123*"
}

### Obtener Información del Usuario Autenticado
GET {{baseUrl}}/api/v1/auth/me
Authorization: Bearer {{authToken}}
Accept: application/json

###############################################################################
# 2. SEDES / SUCURSALES (Branches)
###############################################################################

### Listar todas las Sedes
GET {{baseUrl}}/api/v1/branches
Authorization: Bearer {{authToken}}
Accept: application/json

### Obtener Sede por ID
GET {{baseUrl}}/api/v1/branches/019fd3d8-8f44-7ee7-a7a5-37447251111b
Authorization: Bearer {{authToken}}
Accept: application/json

### Crear Nueva Sede
POST {{baseUrl}}/api/v1/branches
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "code": "LIM-01",
  "name": "Sede Central Lima",
  "address": "Av. Javier Prado Este 1234, San Isidro"
}

### Actualizar Sede
PUT {{baseUrl}}/api/v1/branches/019fd3d8-8f44-7ee7-a7a5-37447251111b
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "code": "LIM-01",
  "name": "Sede Principal Lima - Modificada",
  "address": "Av. Javier Prado Este 5678, San Isidro"
}

### Archivar Sede (Archivado Lógico)
PATCH {{baseUrl}}/api/v1/branches/019fd3d8-8f44-7ee7-a7a5-37447251111b/archive
Authorization: Bearer {{authToken}}

### Desarchivar Sede
PATCH {{baseUrl}}/api/v1/branches/01912a3b-4c5d-7e8f-9a0b-1c2d3e4f5a6b/unarchive
Authorization: Bearer {{authToken}}

### Eliminar Sede (Físicamente si no tiene dependencias)
DELETE {{baseUrl}}/api/v1/branches/01912a3b-4c5d-7e8f-9a0b-1c2d3e4f5a6b
Authorization: Bearer {{authToken}}

###############################################################################
# 3. EMPLEADOS (Employees)
###############################################################################

### Listar Empleados
GET {{baseUrl}}/api/v1/employees
Authorization: Bearer {{authToken}}
Accept: application/json

### Obtener Empleado por ID
GET {{baseUrl}}/api/v1/employees/019fd3e7-1358-7851-a0d4-f5fb0f0700c2
Authorization: Bearer {{authToken}}
Accept: application/json

### Crear Empleado
POST {{baseUrl}}/api/v1/employees
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "code": "EMP-001",
  "firstName": "Juan",
  "lastName": "Pérez",
  "documentType": 1,
  "documentNumber": "72635418",
  "hireDate": "2026-01-15T00:00:00Z",
  "email": "juan.perez@empresa.com",
  "phone": "+51987654321",
  "position": "Desarrollador Senior",
  "department": "Tecnología de la Información"
}

### Actualizar Empleado
PUT {{baseUrl}}/api/v1/employees/01912a3b-4c5d-7e8f-9a0b-1c2d3e4f5a6c
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "code": "EMP-001",
  "firstName": "Juan Carlos",
  "lastName": "Pérez Gómez",
  "documentType": 1,
  "documentNumber": "72635418",
  "hireDate": "2026-01-15T00:00:00Z",
  "email": "juan.perez@empresa.com",
  "phone": "+51987654321",
  "position": "Líder Técnico",
  "department": "Tecnología de la Información"
}

### Archivar Empleado (Archivado Lógico)
PATCH {{baseUrl}}/api/v1/employees/01912a3b-4c5d-7e8f-9a0b-1c2d3e4f5a6c/archive
Authorization: Bearer {{authToken}}

### Desarchivar Empleado
PATCH {{baseUrl}}/api/v1/employees/01912a3b-4c5d-7e8f-9a0b-1c2d3e4f5a6c/unarchive
Authorization: Bearer {{authToken}}

### Eliminar Empleado
DELETE {{baseUrl}}/api/v1/employees/01912a3b-4c5d-7e8f-9a0b-1c2d3e4f5a6c
Authorization: Bearer {{authToken}}

###############################################################################
# 4. ROLES (Roles)
###############################################################################

### Listar Roles
GET {{baseUrl}}/api/v1/roles
Authorization: Bearer {{authToken}}
Accept: application/json

### Obtener Rol por ID
GET {{baseUrl}}/api/v1/roles/019fd3e7-9b9c-764b-b38c-974a3b7206bc
Authorization: Bearer {{authToken}}

### Crear Rol
POST {{baseUrl}}/api/v1/roles
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Supervisor de Operaciones",
  "description": "Acceso a reportes y gestión de personal de sucursal"
}

### Actualizar Rol
PUT {{baseUrl}}/api/v1/roles/01912a3b-4c5d-7e8f-9a0b-1c2d3e4f5a6d
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "name": "Supervisor Senior",
  "description": "Acceso amplio a reportes y operaciones"
}

### Obtener Permisos de un Rol
GET {{baseUrl}}/api/v1/roles/019fd3e7-9b9c-764b-b38c-974a3b7206bc/permissions
Authorization: Bearer {{authToken}}

### Asignar Permisos a un Rol
PUT {{baseUrl}}/api/v1/roles/01912a3b-4c5d-7e8f-9a0b-1c2d3e4f5a6d/permissions
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "permissionKeys": [
    "Permissions.Employees.View",
    "Permissions.Employees.Create",
    "Permissions.Branches.View"
  ]
}

### Eliminar Rol
DELETE {{baseUrl}}/api/v1/roles/01912a3b-4c5d-7e8f-9a0b-1c2d3e4f5a6d
Authorization: Bearer {{authToken}}

###############################################################################
# 5. USUARIOS (Users)
###############################################################################

### Listar Usuarios
GET {{baseUrl}}/api/v1/users
Authorization: Bearer {{authToken}}
Accept: application/json

### Obtener Usuario por ID
GET {{baseUrl}}/api/v1/users/01912a3b-4c5d-7e8f-9a0b-1c2d3e4f5a6e
Authorization: Bearer {{authToken}}

### Crear Usuario
POST {{baseUrl}}/api/v1/users
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "userName": "jperez",
  "password": "Password123!",
  "email": "jperez@empresa.com",
  "displayName": "Juan Pérez",
  "phoneNumber": "+51987654321",
  "branchIds": [],
  "roleIds": []
}

### Actualizar Usuario
PUT {{baseUrl}}/api/v1/users/01912a3b-4c5d-7e8f-9a0b-1c2d3e4f5a6e
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "userName": "jperez",
  "isActive": true,
  "email": "jperez@empresa.com",
  "displayName": "Juan Carlos Pérez",
  "phoneNumber": "+51987654321",
  "branchIds": [],
  "roleIds": []
}

### Cambiar Estado (Activo / Inactivo) de Usuario
PATCH {{baseUrl}}/api/v1/users/01912a3b-4c5d-7e8f-9a0b-1c2d3e4f5a6e/status
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "isActive": false
}

### Resetear Contraseña de Usuario
POST {{baseUrl}}/api/v1/users/01912a3b-4c5d-7e8f-9a0b-1c2d3e4f5a6e/reset-password
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "newPassword": "NewPassword123!",
  "confirmNewPassword": "NewPassword123!"
}

### Obtener Permisos de un Usuario
GET {{baseUrl}}/api/v1/users/01912a3b-4c5d-7e8f-9a0b-1c2d3e4f5a6e/permissions
Authorization: Bearer {{authToken}}

### Asignar Sobrescritura de Permisos Directos a Usuario
PUT {{baseUrl}}/api/v1/users/01912a3b-4c5d-7e8f-9a0b-1c2d3e4f5a6e/permissions
Authorization: Bearer {{authToken}}
Content-Type: application/json

{
  "permissionKeys": [
    "Permissions.Branches.Create"
  ]
}

### Eliminar Usuario
DELETE {{baseUrl}}/api/v1/users/01912a3b-4c5d-7e8f-9a0b-1c2d3e4f5a6e
Authorization: Bearer {{authToken}}
